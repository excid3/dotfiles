#!/usr/bin/env bash
# Sets up a machine from this dotfiles repo. Safe to re-run; existing files
# are backed up to *.backup before being replaced with symlinks.
set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

# System packages. CLI tools come from mise; this is only for what mise can't
# manage: zsh, background services (postgres, redis), GUI apps, fonts, and the
# libraries Ruby needs to compile.
case "$(uname -s)" in
  Darwin)
    if ! command -v brew >/dev/null; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    brew bundle --file "$DOTFILES/Brewfile"
    ;;
  Linux)
    if command -v apt-get >/dev/null; then
      sudo apt-get update
      sudo apt-get install -y zsh git curl unzip fontconfig postgresql redis-server \
        build-essential libssl-dev libyaml-dev zlib1g-dev libffi-dev libpq-dev
      sudo systemctl enable --now postgresql redis-server
    else
      echo "Unsupported Linux distro: install zsh, postgresql, redis, and Ruby build deps manually." >&2
    fi
    if [ "$(basename "$SHELL")" != "zsh" ]; then
      chsh -s "$(command -v zsh)"
    fi
    # Same font the Brewfile cask installs on macOS
    if ! fc-list | grep -qi "FiraCode Nerd Font"; then
      mkdir -p "$HOME/.local/share/fonts"
      curl -fsSL -o /tmp/FiraCode.zip https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FiraCode.zip
      unzip -oq /tmp/FiraCode.zip -d "$HOME/.local/share/fonts/FiraCodeNerdFont"
      rm /tmp/FiraCode.zip
      fc-cache -f
    fi
    ;;
esac

# Oh-My-ZSH
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

link() {
  local src="$1" dest="$2"
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    echo "ok: $dest"
    return
  fi
  if [ -e "$dest" ]; then
    mv "$dest" "$dest.backup"
    echo "backed up: $dest -> $dest.backup"
  fi
  ln -s "$src" "$dest"
  echo "linked: $dest -> $src"
}

link "$DOTFILES/zsh/themes/excid3.zsh-theme" "$HOME/.oh-my-zsh/themes/excid3.zsh-theme"
link "$DOTFILES/zsh/zshrc" "$HOME/.zshrc"
link "$DOTFILES/bash/bashrc" "$HOME/.bashrc"
link "$DOTFILES/bash/bash_profile" "$HOME/.bash_profile"
link "$DOTFILES/psqlrc" "$HOME/.psqlrc"
link "$DOTFILES/gemrc" "$HOME/.gemrc"

mkdir -p "$HOME/.config/nvim"
link "$DOTFILES/nvim/init.lua" "$HOME/.config/nvim/init.lua"

# Ghostty loads the Application Support path last on macOS, so it overrides
# ~/.config/ghostty there
if [ "$(uname -s)" = "Darwin" ]; then
  ghostty_dir="$HOME/Library/Application Support/com.mitchellh.ghostty"
else
  ghostty_dir="$HOME/.config/ghostty"
fi
mkdir -p "$ghostty_dir"
link "$DOTFILES/ghostty/config" "$ghostty_dir/config"

# Copied instead of symlinked: these apps rewrite their config files in place,
# which would replace a symlink. Only seeded when missing so live settings win.
mkdir -p "$HOME/.config/mise"
[ -f "$HOME/.config/mise/config.toml" ] || cp "$DOTFILES/mise/config.toml" "$HOME/.config/mise/config.toml"
if [ "$(uname -s)" = "Darwin" ]; then
  mkdir -p "$HOME/.config/openlogi"
  [ -f "$HOME/.config/openlogi/config.toml" ] || cp "$DOTFILES/openlogi/config.toml" "$HOME/.config/openlogi/config.toml"
fi

# Languages and CLI tools (node, ruby, neovim, tree-sitter, delta, overmind, tmux, gh, jq)
mise install --yes

# Git: delta pager and lg alias
git config --global color.ui true
git config --global core.pager delta
git config --global interactive.diffFilter 'delta --color-only'
git config --global delta.navigate true
git config --global delta.dark true
git config --global merge.conflictStyle zdiff3
git config --global alias.lg "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --"

echo "Bootstrap complete. Open a new shell to pick up the zsh config."
